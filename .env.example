NEXT_PUBLIC_SUPABASE_URL=https://PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=SUPABASE_ANON_KEY

FT_API_CLIENT_ID=42_INTRA_CLIENT_ID
FT_API_CLIENT_SECRET=42_INTRA_CLIENT_SECRET
# Optional. Used for "yesterday" in 42 locations_stats.
FT_API_TIME_ZONE=Europe/Istanbul

# Only needed when running `npm run auth:setup42`.
# Never expose this in client code.
SUPABASE_SERVICE_ROLE_KEY=SUPABASE_SERVICE_ROLE_KEY
