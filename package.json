{
  "name": "grind42-temp",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "auth:setup42": "node scripts/setup-42-provider.mjs",
    "postinstall": "node -e \"try{const p=require.resolve('lightningcss-darwin-arm64/lightningcss.darwin-arm64.node');const fs=require('fs');const t=require('path').join(require.resolve('lightningcss/package.json'),'..','lightningcss.darwin-arm64.node');if(!fs.existsSync(t))fs.symlinkSync(p,t);}catch(e){}\""
  },
  "dependencies": {
    "@supabase/ssr": "^0.10.3",
    "@supabase/supabase-js": "^2.105.4",
    "framer-motion": "^12.38.0",
